{
    "name": "@retter/sdk",
    "version": "0.15.0",
    "description": "Client sdk for retter.io",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "bundle"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rettersoft/retter-js-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/rettersoft/retter-js-sdk/issues"
    },
    "homepage": "https://github.com/rettersoft/retter-js-sdk#readme",
    "author": "Semih Ayhan",
    "license": "ISC",
    "packageManager": "bun@1.3.14",
    "dependencies": {
        "@types/js-cookie": "3.0.6",
        "axios": "1.18.0",
        "firebase": "12.17.0",
        "js-cookie": "3.0.8",
        "jwt-decode": "4.0.0",
        "rxjs": "7.8.2"
    },
    "scripts": {
        "prebuild": "bun scripts/gen-version.js",
        "build": "tsc && bun scripts/build-bundle.js",
        "pretest": "bun scripts/gen-version.js",
        "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
        "bump": "bun scripts/bump.js",
        "release": "bun scripts/publish.js"
    },
    "devDependencies": {
        "@types/node": "22.10.10",
        "typescript": "5.7.3"
    }
}
